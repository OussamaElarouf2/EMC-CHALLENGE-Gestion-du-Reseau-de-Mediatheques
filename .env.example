# .env.example — Reference documentation for environment variables
# Copy this file to .env.local to customize your local configuration.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_32_chars_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format: mysql://<user>:<password>@<host>:<port>/<dbname>?serverVersion=8.0&charset=utf8mb4
# For local development with MySQL in Docker: overridden in git-ignored .env.local (127.0.0.1:3307)
# For Docker delivery: host is db:3306 (internal network).
DATABASE_URL="mysql://app_user:app_password@db:3306/mediatheque?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

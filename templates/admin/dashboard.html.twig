{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    <span class="fw-bold">Tableau de bord — Réseau des Médiathèques</span>
{% endblock %}

{% block main %}
    <div class="row g-3 mb-4">
        {# Sites #}
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary-subtle text-primary rounded p-3 me-3">
                        <i class="fa fa-building fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small">Médiathèques</div>
                        <h3 class="mb-0 fw-bold">{{ stats.branches }}</h3>
                    </div>
                </div>
            </div>
        </div>

        {# Editions & Copies #}
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-success-subtle text-success rounded p-3 me-3">
                        <i class="fa fa-book fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small">Éditions / Exemplaires</div>
                        <h3 class="mb-0 fw-bold">{{ stats.editions }} <span class="fs-6 fw-normal text-muted">/ {{ stats.copies }} ex.</span></h3>
                    </div>
                </div>
            </div>
        </div>

        {# Members #}
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-info-subtle text-info rounded p-3 me-3">
                        <i class="fa fa-id-card fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small">Adhérents inscrits</div>
                        <h3 class="mb-0 fw-bold">{{ stats.members }}</h3>
                    </div>
                </div>
            </div>
        </div>

        {# Active loans #}
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 bg-warning-subtle text-warning rounded p-3 me-3">
                        <i class="fa fa-hand-holding fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small">Prêts en cours</div>
                        <h3 class="mb-0 fw-bold">{{ stats.active_loans }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        {# Waiting / Ready Reservations #}
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold border-0 pt-3">
                    <i class="fa fa-clock text-warning me-2"></i>Réservations actives
                </div>
                <div class="card-body pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            En file d'attente (FIFO)
                            <span class="badge bg-warning rounded-pill">{{ stats.waiting_reservations }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Prêtes pour retrait (5 jours)
                            <span class="badge bg-success rounded-pill">{{ stats.ready_reservations }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {# Transfers #}
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold border-0 pt-3">
                    <i class="fa fa-truck text-primary me-2"></i>Logistique inter-sites
                </div>
                <div class="card-body pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Transferts en transit
                            <span class="badge bg-primary rounded-pill">{{ stats.transfers }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Sites connectés
                            <span class="text-muted">{{ stats.branches }} médiathèques</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {# Penalties #}
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold border-0 pt-3">
                    <i class="fa fa-circle-exclamation text-danger me-2"></i>Pénalités de retard
                </div>
                <div class="card-body pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Pénalités impayées
                            <span class="badge bg-danger rounded-pill">{{ stats.unpaid_penalties }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Barème d'application
                            <span class="text-muted">Par jour de retard (selon formule)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Catalogue — Réseau de Médiathèques{% endblock %}

{% block stylesheets %}
<style>
    /* Full-page grand library background with elegant soft overlay */
    body {
        background-color: #f1f5f9;
        background-image: 
            linear-gradient(rgba(248, 250, 252, 0.80), rgba(241, 245, 249, 0.85)),
            url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1920&q=80') !important;
        background-position: center center !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
        background-attachment: fixed !important;
    }

    .catalogue-hero {
        background: rgba(255, 255, 255, 0.93) !important;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        border-radius: 16px;
    }

    .catalogue-card {
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(6px);
        border-radius: 14px;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .catalogue-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.14) !important;
    }

    .cover-wrapper {
        height: 200px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-bottom: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .cover-wrapper img {
        max-height: 184px;
        max-width: 90%;
        object-fit: contain;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.16));
        transition: transform 0.25s ease;
    }

    .catalogue-card:hover .cover-wrapper img {
        transform: scale(1.05);
    }
</style>
{% endblock %}

{% block body %}
<!-- Hero Header (Grand Library Title & Filter Form) -->
<div class="card shadow-sm border-0 mb-4 catalogue-hero">
    <div class="card-body p-4 p-lg-5">
        <div class="row align-items-center mb-3">
            <div class="col-lg-8">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2 px-3 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-buildings me-1"></i> Réseau de Médiathèques
                </span>
                <h1 class="h2 fw-bold mb-2 text-dark">
                    <i class="bi bi-book-half me-2 text-primary"></i>Catalogue du Réseau
                </h1>
                <p class="text-muted lead fs-6 mb-0">
                    Explorez les livres, bandes dessinées et DVD disponibles au prêt dans nos deux médiathèques de quartier.
                </p>
            </div>
        </div>

        <form method="get" action="{{ path('app_catalogue') }}" class="row g-2 pt-2">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" name="q" value="{{ currentQuery }}" class="form-control" placeholder="Rechercher par titre, auteur, éditeur, ISBN...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select bg-white">
                    <option value="">Tous les supports</option>
                    {% for media in mediaTypes %}
                        <option value="{{ media.value }}" {{ currentType == media.value ? 'selected' : '' }}>
                            {% if media.value == 'BOOK' %}Livre
                            {% elseif media.value == 'COMIC' %}Bande Dessinée
                            {% elseif media.value == 'DVD' %}DVD / Vidéo
                            {% else %}{{ media.value }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Filtrer
                </button>
                {% if currentQuery or currentType %}
                    <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary" title="Réinitialiser">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

<!-- Results Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-dark small fw-semibold bg-white bg-opacity-75 px-3 py-1 rounded-pill border">
        <strong>{{ total }}</strong> document(s) trouvé(s)
        {% if currentQuery %} pour "<em>{{ currentQuery }}</em>"{% endif %}
        {% if currentType %} (support : <strong>{{ currentType }}</strong>){% endif %}
    </div>
    {% if pages > 1 %}
        <div class="text-dark small fw-semibold bg-white bg-opacity-75 px-3 py-1 rounded-pill border">
            Page {{ page }} sur {{ pages }}
        </div>
    {% endif %}
</div>

<!-- Editions Grid -->
{% if editions is empty %}
    <div class="card border-0 shadow-sm text-center p-5 catalogue-hero">
        <div class="display-6 text-muted mb-3"><i class="bi bi-inbox"></i></div>
        <h4 class="h5 fw-bold text-dark">Aucun document ne correspond à votre recherche</h4>
        <p class="text-muted small mb-3">Essayez d'élargir vos termes de recherche ou de retirer les filtres.</p>
        <div>
            <a href="{{ path('app_catalogue') }}" class="btn btn-outline-primary btn-sm">Réinitialiser la recherche</a>
        </div>
    </div>
{% else %}
    <div class="row g-4 mb-4">
        {% for edition in editions %}
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 border-0 shadow-sm catalogue-card overflow-hidden">
                    <!-- Document Cover Visual -->
                    <div class="cover-wrapper position-relative">
                        {% if edition.coverUrl %}
                            <img src="{{ edition.coverUrl }}" alt="{{ edition.title }}" loading="lazy">
                        {% else %}
                            {% if edition.mediaType.value == 'BOOK' %}
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);">
                                    <i class="bi bi-book text-primary opacity-75" style="font-size: 3.2rem;"></i>
                                    <span class="badge bg-primary text-white mt-1" style="font-size: 0.7rem;">Livre</span>
                                </div>
                            {% elseif edition.mediaType.value == 'COMIC' %}
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #dcfce7 0%, #f0fdf4 100%);">
                                    <i class="bi bi-brush text-success opacity-75" style="font-size: 3.2rem;"></i>
                                    <span class="badge bg-success text-white mt-1" style="font-size: 0.7rem;">Bande Dessinée</span>
                                </div>
                            {% elseif edition.mediaType.value == 'DVD' %}
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, #fee2e2 0%, #fef2f2 100%);">
                                    <i class="bi bi-disc text-danger opacity-75" style="font-size: 3.2rem;"></i>
                                    <span class="badge bg-danger text-white mt-1" style="font-size: 0.7rem;">DVD Vidéo</span>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            {% if edition.mediaType.value == 'BOOK' %}
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-book me-1"></i>Livre
                                </span>
                            {% elseif edition.mediaType.value == 'COMIC' %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-brush me-1"></i>Bande Dessinée
                                </span>
                            {% elseif edition.mediaType.value == 'DVD' %}
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    <i class="bi bi-disc me-1"></i>DVD
                                </span>
                            {% endif %}

                            {% if edition.isbn %}
                                <small class="text-muted font-monospace" style="font-size: 0.75rem;">{{ edition.isbn }}</small>
                            {% endif %}
                        </div>

                        <h2 class="card-title h6 fw-bold mb-1">
                            <a href="{{ path('app_catalogue_show', {id: edition.id}) }}" class="text-decoration-none text-dark stretched-link">
                                {{ edition.title }}
                            </a>
                        </h2>

                        {% if edition.work and edition.work.originalTitle != edition.title %}
                            <div class="text-muted small mb-2 fst-italic">
                                Œuvre : {{ edition.work.originalTitle }}
                            </div>
                        {% endif %}

                        <div class="small text-muted mb-2">
                            {% if edition.contributors is not empty %}
                                <i class="bi bi-person me-1"></i>
                                {% for ec in edition.contributors %}
                                    {{ ec.contributor.name }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            {% else %}
                                <span class="text-muted fst-italic">Auteur non renseigné</span>
                            {% endif %}
                        </div>

                        <div class="mt-auto pt-2 border-top small text-muted d-flex justify-content-between align-items-center">
                            <span>{{ edition.publisher }} ({{ edition.publicationYear }})</span>
                            <span class="text-primary fw-semibold"><i class="bi bi-chevron-right"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if pages > 1 %}
        <nav aria-label="Pagination catalogue" class="d-flex justify-content-center">
            <ul class="pagination">
                {% if page > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_catalogue', {q: currentQuery, type: currentType, page: page - 1}) }}">
                            &laquo; Précédent
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled"><span class="page-link">&laquo; Précédent</span></li>
                {% endif %}

                {% for p in 1..pages %}
                    {% if p == page %}
                        <li class="page-item active"><span class="page-link">{{ p }}</span></li>
                    {% elseif p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_catalogue', {q: currentQuery, type: currentType, page: p}) }}">
                                {{ p }}
                            </a>
                        </li>
                    {% elseif p == page - 3 or p == page + 3 %}
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    {% endif %}
                {% endfor %}

                {% if page < pages %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('app_catalogue', {q: currentQuery, type: currentType, page: page + 1}) }}">
                            Suivant &raquo;
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled"><span class="page-link">Suivant &raquo;</span></li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Erreur système — Réseau de Médiathèques{% endblock %}

{% block body %}
<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <div class="display-1 text-warning fw-bold mb-3">
                    <i class="bi bi-exclamation-triangle"></i> Erreur
                </div>
                <h1 class="h3 fw-bold mb-3">Une erreur est survenue</h1>
                <p class="text-muted mb-4 lead">
                    Le service a rencontré une anomalie temporaire. Veuillez réessayer dans quelques instants.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_catalogue') }}" class="btn btn-primary px-4">
                        <i class="bi bi-book me-2"></i>Retour au catalogue
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
